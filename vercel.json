{
  "version": 2,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "herdbook.graceandgrithomeco.com"
        }
      ],
      "dest": "/herdbook/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "ledger.graceandgrithomeco.com"
        }
      ],
      "dest": "/ledger/$1"
    },
    {
      "src": "/herdbook",
      "status": 308,
      "headers": {
        "Location": "/herdbook/"
      }
    },
    {
      "src": "/ledger",
      "status": 308,
      "headers": {
        "Location": "/ledger/"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
